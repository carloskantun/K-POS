{
  "name": "k-pos",
  "version": "0.1.0",
  "private": true,
  "description": "POS PWA multi-negocio offline-first con sincronización en Cloudflare Workers + D1 y reportes por Telegram",
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "node --no-warnings hub/server.js",
    "test": "node --no-warnings --test test/*.test.js",
    "db:migrate": "wrangler d1 migrations apply k-pos --remote",
    "db:migrate:local": "wrangler d1 migrations apply k-pos --local",
    "deploy": "wrangler deploy",
    "e2e": "node test/e2e.mjs http://localhost:8787 test-results"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
